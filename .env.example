# =================================
# Diabetes Risk Prediction ML Healthcare Configuration
# =================================

# Healthcare Application Settings
HEALTHCARE_MODE=clinical
MODEL_VERSION=1.0.0
CLINICAL_VALIDATION=enabled
PATIENT_PRIVACY=strict

# Dataset Configuration
DATASET_URL=https://www.dropbox.com/scl/fi/0uiujtei423te1q4kvrny/diabetes.csv?rlkey=20xvytca6xbio4vsowi2hdj8e&st=uv8fbcue&dl=1
DATASET_PATH=data/diabetes_dataset.csv
PROCESSED_DATA_PATH=data/processed/

# Model Configuration
MODEL_PATH=models/diabetes_classifier.pkl
SCALER_PATH=models/feature_scaler.pkl
MODEL_TYPE=svm
KERNEL_TYPE=linear

# Clinical Performance Thresholds
MIN_ACCURACY=0.90
MIN_SENSITIVITY=0.85
MIN_SPECIFICITY=0.90
MIN_F1_SCORE=0.87

# Healthcare Compliance
HIPAA_COMPLIANCE=true
MEDICAL_DISCLAIMER=enabled
AUDIT_LOGGING=true

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=diabetes_prediction.log

# Training Configuration
TEST_SIZE=0.2
RANDOM_STATE=42
CROSS_VALIDATION_FOLDS=5

# Clinical Features
FEATURE_COUNT=8
TARGET_COLUMN=Outcome